# ---------------------------------------------------------------------------
# JobOps mobile — PUBLIC configuration only.
#
# Everything here is bundled into the app and is readable by anyone who
# inspects the binary. NEVER put server secrets here (LLM API keys, JWT
# signing secret, Gmail client secret, database credentials, SMTP, Stripe,
# etc.). The app only ever holds a per-user JWT obtained from the backend at
# runtime via POST /api/auth/login.
# ---------------------------------------------------------------------------

# Base URL of the existing JobOps Express API (defaults to http://localhost:3001).
# The server listens on PORT (default 3001) and mounts all routes under /api.
#
# - Simulator / emulator on the same machine: http://localhost:3001
#   (Android emulator: use http://10.0.2.2:3001)
# - Physical device on your LAN: http://<your-computer-LAN-IP>:3001
# - Staging / production: your HTTPS origin, e.g. https://api.example.com
EXPO_PUBLIC_API_URL=http://localhost:3001

# Reversed-domain app identifier (iOS bundle id + Android package + deep-link).
# EXPO_PUBLIC_APP_ID=com.jobops.mobile

# EAS project id (set automatically by `eas init`; optional to pin here).
# EXPO_PUBLIC_EAS_PROJECT_ID=
